---
const { lang = 'es', title, description, alternateHref, alternateLabel } = Astro.props;
const isSpanish = lang === 'es';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Pedro Villavicencio</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020612" />
  </head>
  <body>
    <div class="archive-page">
      <header class="archive-header">
        <a class="archive-brand" href="/" aria-label="Pedro Villavicencio home">PV›_</a>
        <nav aria-label={isSpanish ? 'Navegación editorial' : 'Editorial navigation'}>
          <a href="/">{isSpanish ? 'Inicio' : 'Home'}</a>
          <a class="language-toggle" href={alternateHref}>{alternateLabel} <span>→</span></a>
        </nav>
      </header>
      <main>
        <p class="archive-eyebrow">{isSpanish ? 'ARCHIVO PERSONAL' : 'PERSONAL ARCHIVE'}</p>
        <h1>{title}</h1>
        <p class="archive-description">{description}</p>
        <slot />
      </main>
      <footer class="archive-footer"><a href="/">Pedro Villavicencio</a><span>{isSpanish ? 'Historias, proyectos y memoria técnica' : 'Stories, projects and technical memory'}</span></footer>
    </div>
  </body>
</html>

<style is:global>
  :root{--bg:#020612;--line:rgba(148,163,184,.18);--text:#f8fafc;--muted:#c8d2e4;--soft:#94a3b8;--blue:#55a8ff;--violet:#8b5cf6}
  *{box-sizing:border-box}
  body{margin:0;min-width:320px;color:var(--text);background:radial-gradient(circle at 82% 12%,rgba(96,80,255,.2),transparent 28%),linear-gradient(135deg,#020612 0%,#07152e 52%,#020612 100%);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6}
  a{color:inherit;text-decoration:none}
  .archive-page{width:min(100% - 48px,1240px);margin:auto;padding:28px 0 34px}
  .archive-header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-bottom:24px;border-bottom:1px solid rgba(148,163,184,.14)}
  .archive-brand{font-size:2.5rem;font-weight:900;letter-spacing:-.08em;background:linear-gradient(135deg,#a78bfa,#2f80ff 56%,#9db8ff);-webkit-background-clip:text;background-clip:text;color:transparent}
  .archive-header nav{display:flex;align-items:center;gap:24px;color:#d8e1f2}
  .language-toggle{padding:8px 13px;border:1px solid rgba(85,168,255,.32);border-radius:999px;background:rgba(8,18,38,.64);color:#eaf0ff}
  .language-toggle span{color:var(--blue)}
  main{padding:82px 0 0}
  .archive-eyebrow{margin:0 0 14px;color:var(--blue);font-size:.76rem;font-weight:850;letter-spacing:.18em}
  h1{max-width:840px;margin:0;font-size:clamp(3.4rem,8vw,7rem);line-height:.92;letter-spacing:-.07em}
  .archive-description{max-width:690px;margin:24px 0 58px;color:var(--muted);font-size:1.2rem}
  .archive-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .archive-card{display:flex;min-height:300px;flex-direction:column;padding:26px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,rgba(9,18,35,.82),rgba(3,9,20,.68));box-shadow:0 22px 60px rgba(0,0,0,.25);transition:transform .18s ease,border-color .18s ease}
  .archive-card:hover{transform:translateY(-4px);border-color:rgba(85,168,255,.44)}
  .archive-card .card-kicker{margin:0 0 30px;color:var(--blue);font-size:.76rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .archive-card h2{margin:0 0 14px;font-size:1.75rem;line-height:1.1;letter-spacing:-.04em}
  .archive-card p{margin:0;color:var(--muted)}
  .archive-card .card-link{margin-top:auto;padding-top:30px;color:var(--blue);font-weight:800}
  .archive-footer{display:flex;justify-content:space-between;gap:18px;margin-top:84px;padding-top:20px;border-top:1px solid rgba(148,163,184,.14);color:var(--soft);font-size:.9rem}.archive-footer a{color:#fff}
  @media(max-width:720px){.archive-page{width:min(100% - 30px,700px);padding-top:18px}.archive-header{align-items:flex-start}.archive-header nav{gap:10px;flex-direction:column;align-items:flex-end}main{padding-top:58px}.archive-list{grid-template-columns:1fr}.archive-footer{flex-direction:column;gap:6px}}
</style>
