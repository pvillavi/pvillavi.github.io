---
const {
  lang = 'es',
  title,
  description,
  date = 'Borrador inicial',
  series = 'Serie Hipo',
  part,
  tags = [],
  alternateHref,
  alternateLabel,
  archiveHref,
} = Astro.props;

const isSpanish = lang === 'es';
const archiveLabel = isSpanish ? 'Volver al archivo' : 'Back to the archive';
const seriesLabel = isSpanish ? 'Serie Hipo' : 'Hipo series';
const languageNote = isSpanish ? 'English version' : 'Versión en español';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Pedro Villavicencio</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020612" />
    <link rel="alternate" hreflang={isSpanish ? 'en' : 'es'} href={`https://pvillavi.github.io${alternateHref}`} />
  </head>
  <body>
    <div class="editorial-page">
      <header class="editorial-header">
        <a class="editorial-brand" href="/" aria-label="Pedro Villavicencio home">PV›_</a>
        <nav aria-label={isSpanish ? 'Navegación editorial' : 'Editorial navigation'}>
          <a href={archiveHref}>{archiveLabel}</a>
          <a class="language-toggle" href={alternateHref}>{languageNote} <span>→</span></a>
        </nav>
      </header>

      <div class="editorial-breadcrumbs">
        <a href={archiveHref}>{seriesLabel}</a>
        <span>/</span>
        <span>{part ? `${isSpanish ? 'Parte' : 'Part'} ${part}` : series}</span>
      </div>

      <main class="article-grid">
        <article class="article-content">
          <p class="article-eyebrow">{series}</p>
          <h1>{title}</h1>
          <p class="article-description">{description}</p>
          <div class="article-meta">
            <span>{date}</span>
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <div class="article-body">
            <slot />
          </div>
        </article>

        <aside class="article-aside" aria-label={isSpanish ? 'Navegación de la serie' : 'Series navigation'}>
          <p class="aside-eyebrow">{seriesLabel}</p>
          <h2>{isSpanish ? 'Una historia en cuatro movimientos' : 'A story in four movements'}</h2>
          <ol>
            <li class="current">{isSpanish ? 'Cómo empezó Hipo' : 'How Hipo started'}</li>
            <li>{isSpanish ? 'C#, Mono y GNOME' : 'C#, Mono and GNOME'}</li>
            <li>{isSpanish ? 'La arquitectura por dentro' : 'The architecture inside'}</li>
            <li>{isSpanish ? 'El trabajo invisible' : 'The invisible work'}</li>
          </ol>
          <a class="aside-link" href={isSpanish ? '/es/proyectos/hipo/' : '/en/projects/hipo/'}>
            {isSpanish ? 'Ver el proyecto Hipo' : 'View the Hipo project'} →
          </a>
        </aside>
      </main>

      <footer class="editorial-footer">
        <a href="/">Pedro Villavicencio</a>
        <span>{isSpanish ? 'Archivo personal y editorial' : 'Personal and editorial archive'}</span>
        <a href={alternateHref}>{alternateLabel}</a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root{--bg:#020612;--panel:rgba(9,18,35,.78);--line:rgba(148,163,184,.18);--text:#f8fafc;--muted:#c8d2e4;--soft:#94a3b8;--blue:#55a8ff;--violet:#8b5cf6}
  *{box-sizing:border-box}
  html{background:var(--bg);scroll-behavior:smooth}
  body{margin:0;min-width:320px;color:var(--text);background:radial-gradient(circle at 82% 12%,rgba(96,80,255,.2),transparent 28%),linear-gradient(135deg,#020612 0%,#07152e 52%,#020612 100%);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.65}
  a{color:inherit;text-decoration:none}
  .editorial-page{width:min(100% - 48px,1240px);margin:auto;padding:28px 0 30px}
  .editorial-header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-bottom:24px;border-bottom:1px solid rgba(148,163,184,.14)}
  .editorial-brand{font-size:2.5rem;font-weight:900;letter-spacing:-.08em;background:linear-gradient(135deg,#a78bfa,#2f80ff 56%,#9db8ff);-webkit-background-clip:text;background-clip:text;color:transparent}
  .editorial-header nav{display:flex;align-items:center;gap:24px;color:#d8e1f2;font-size:.98rem}
  .editorial-header nav a:hover{color:#fff}
  .language-toggle{padding:8px 13px;border:1px solid rgba(85,168,255,.32);border-radius:999px;background:rgba(8,18,38,.64);color:#eaf0ff}
  .language-toggle span{color:var(--blue)}
  .editorial-breadcrumbs{display:flex;gap:10px;margin:38px 0 24px;color:var(--soft);font-size:.92rem}
  .editorial-breadcrumbs a{color:var(--blue)}
  .article-grid{display:grid;grid-template-columns:minmax(0,760px) 280px;gap:70px;align-items:start}
  .article-eyebrow,.aside-eyebrow{margin:0 0 14px;color:var(--blue);font-size:.76rem;font-weight:850;letter-spacing:.18em;text-transform:uppercase}
  .article-content h1{max-width:780px;margin:0;font-size:clamp(2.8rem,6vw,5.6rem);line-height:.98;letter-spacing:-.065em;text-wrap:balance}
  .article-description{max-width:700px;margin:24px 0 20px;color:var(--muted);font-size:1.25rem;line-height:1.55}
  .article-meta{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:46px;color:var(--soft);font-size:.92rem}
  .tag{padding:5px 10px;border:1px solid rgba(148,163,184,.2);border-radius:999px;color:#dce6f7;background:rgba(255,255,255,.035)}
  .article-body{color:#d9e2f0;font-size:1.1rem}
  .article-body h2{margin:42px 0 12px;color:#fff;font-size:1.7rem;line-height:1.2;letter-spacing:-.03em}
  .article-body h3{margin:30px 0 8px;color:#fff;font-size:1.25rem}
  .article-body p{max-width:700px;margin:0 0 22px}
  .article-body strong{color:#fff}
  .article-body blockquote{margin:30px 0;padding:18px 22px;border-left:3px solid var(--violet);border-radius:0 12px 12px 0;background:rgba(139,92,246,.1);color:#eef2ff}
  .article-aside{position:sticky;top:26px;padding:22px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,rgba(9,18,35,.84),rgba(3,9,20,.7));box-shadow:0 24px 70px rgba(0,0,0,.28)}
  .article-aside h2{margin:0 0 20px;font-size:1.3rem;line-height:1.2}
  .article-aside ol{display:grid;gap:14px;margin:0;padding:0;list-style:none;counter-reset:series}
  .article-aside li{counter-increment:series;display:grid;grid-template-columns:26px 1fr;gap:10px;color:var(--soft);font-size:.94rem}
  .article-aside li::before{content:counter(series,decimal-leading-zero);color:var(--blue);font-weight:800}
  .article-aside li.current{color:#fff}
  .aside-link{display:block;margin-top:24px;padding-top:18px;border-top:1px solid rgba(148,163,184,.14);color:var(--blue);font-weight:750}
  .editorial-footer{display:flex;justify-content:space-between;gap:18px;margin-top:84px;padding-top:20px;border-top:1px solid rgba(148,163,184,.14);color:var(--soft);font-size:.9rem}
  .editorial-footer a:first-child{color:#fff}
  @media(max-width:900px){.article-grid{grid-template-columns:1fr;gap:42px}.article-aside{position:static;max-width:520px}.article-content h1{font-size:clamp(2.8rem,9vw,4.5rem)}}
  @media(max-width:560px){.editorial-page{width:min(100% - 30px,700px);padding-top:18px}.editorial-header{align-items:flex-start}.editorial-header nav{gap:10px;flex-direction:column;align-items:flex-end}.editorial-brand{font-size:2.2rem}.article-description{font-size:1.08rem}.article-meta{margin-bottom:34px}.article-body{font-size:1rem}.editorial-footer{flex-direction:column;gap:6px;margin-top:58px}}
</style>
